{
  "manifest_version": 2,
  "name": "WebTool Inspector",
  "version": "1.4.0",
  "description": "Technologies, IP, ASN, WHOIS/RDAP, DNS, TLS certificate and HTTP headers for the current site — at a glance.",
  "author": "PAPAMICA",
  "homepage_url": "https://github.com/PAPAMICA/webtool-extension",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "webtool-inspector@papamica",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "dns",
    "cookies",
    "storage"
  ],
  "background": {
    "scripts": [
      "src/lib/api.js",
      "src/lib/settings.js",
      "src/lib/technologies.js",
      "src/lib/detector.js",
      "src/lib/x509.js",
      "src/lib/lookup.js",
      "src/lib/version-probe.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/lib/api.js",
        "src/lib/settings.js",
        "src/lib/technologies.js",
        "src/content/collect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "WebTool Inspector"
  }
}
