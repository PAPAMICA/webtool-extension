{
  "manifest_version": 3,
  "name": "WebTool Inspector",
  "version": "1.4.0",
  "description": "Technologies, IP, ASN, WHOIS/RDAP, DNS, TLS certificate and HTTP headers for the current site — at a glance.",
  "author": "PAPAMICA",
  "homepage_url": "https://github.com/PAPAMICA/webtool-extension",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "WebTool Inspector"
  },
  "background": {
    "service_worker": "src/background-chrome.js"
  },
  "permissions": [
    "webRequest",
    "tabs",
    "cookies",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/lib/api.js",
        "src/lib/settings.js",
        "src/lib/technologies.js",
        "src/content/collect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data:;"
  }
}
